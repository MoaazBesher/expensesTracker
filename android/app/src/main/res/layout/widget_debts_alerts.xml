<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1C2128">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Debts &amp; Alerts"
        android:textColor="#F0F6FC"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I Owe"
                android:textColor="#8B949E"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/i_owe_amt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0"
                android:textColor="#F85149"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Owed Me"
                android:textColor="#8B949E"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/owed_me_amt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0"
                android:textColor="#3FB950"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/alerts_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 active alerts"
        android:textColor="#8B949E"
        android:textSize="11sp" />

</LinearLayout>
