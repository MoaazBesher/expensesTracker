<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quick Add"
        android:textColor="#F0F6FC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Type Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/button_secondary"
        android:padding="3dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_expense"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Expense"
            android:textSize="12sp"
            android:textColor="#F85149"
            android:textStyle="bold"
            android:backgroundTint="#F8514920"
            android:layout_marginEnd="2dp" />

        <Button
            android:id="@+id/btn_income"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Income"
            android:textSize="12sp"
            android:textColor="#8B949E"
            android:backgroundTint="#0D1117"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- Amount -->
    <EditText
        android:id="@+id/edit_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Amount"
        android:textColor="#F0F6FC"
        android:textColorHint="#484F58"
        android:textSize="18sp"
        android:textStyle="bold"
        android:inputType="numberDecimal"
        android:background="@drawable/input_background"
        android:padding="14dp"
        android:layout_marginTop="12dp" />

    <!-- Category Spinner -->
    <Spinner
        android:id="@+id/spinner_category"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/input_background"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:popupBackground="#161B22"
        android:layout_marginTop="10dp" />

    <!-- Note -->
    <EditText
        android:id="@+id/edit_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Note"
        android:textColor="#F0F6FC"
        android:textColorHint="#484F58"
        android:textSize="13sp"
        android:inputType="text"
        android:background="@drawable/input_background"
        android:padding="14dp"
        android:layout_marginTop="10dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="#8B949E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/button_secondary"
            android:backgroundTint="@null"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="2"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary"
            android:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
