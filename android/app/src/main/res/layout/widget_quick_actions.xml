<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_add_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_chip_green"
            android:padding="4dp"
            android:text="+Inc"
            android:textColor="#3FB950"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_add_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_chip_red"
            android:padding="4dp"
            android:text="-Exp"
            android:textColor="#F85149"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_add_alert"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_chip_orange"
            android:padding="4dp"
            android:text="Alert"
            android:textColor="#D29922"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_add_debt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_chip_purple"
            android:padding="4dp"
            android:text="Debt"
            android:textColor="#BC8CFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
