<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quick Actions"
        android:textColor="#F0F6FC"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_add_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_chip_green"
            android:padding="6dp"
            android:text="+ Income"
            android:textColor="#3FB950"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_add_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_chip_red"
            android:padding="6dp"
            android:text="- Expense"
            android:textColor="#F85149"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_add_alert"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/widget_chip_orange"
            android:padding="6dp"
            android:text="Alert"
            android:textColor="#D29922"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_add_debt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/widget_chip_purple"
            android:padding="6dp"
            android:text="Debt"
            android:textColor="#BC8CFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
