<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="Expenses Tracker"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:enableOnBackInvokedCallback="false"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link for widget actions -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="expensestracker" android:host="action" />
            </intent-filter>
        </activity>

        <!-- Quick Add Floating Dialog (no full app launch) -->
        <activity
            android:name=".QuickAddActivity"
            android:theme="@style/QuickAddTheme"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:autoRemoveFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Summary Home Screen Widget -->
        <receiver
            android:name=".ExpenseSummaryWidget"
            android:label="Finance Summary"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_summary_info" />
        </receiver>

        <!-- Quick Actions Home Screen Widget -->
        <receiver
            android:name=".QuickActionsWidget"
            android:label="Quick Actions"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>

        <!-- Recent Transactions Home Screen Widget -->
        <receiver
            android:name=".RecentTransactionsWidget"
            android:label="Recent Activity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent_info" />
        </receiver>

        <!-- Debts & Alerts Home Screen Widget -->
        <receiver
            android:name=".DebtsAlertsWidget"
            android:label="Debts &amp; Alerts"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_debts_alerts_info" />
        </receiver>

        <!-- Quick Settings Tile (notification bar shortcut) -->
        <service
            android:name=".ExpenseQuickTile"
            android:label="@string/tile_label"
            android:icon="@android:drawable/ic_input_add"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
